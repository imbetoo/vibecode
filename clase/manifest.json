{
  "manifest_version": 3,
  "name": "Clase",
  "short_name": "Clase",
  "version": "1.4.0",
  "description": "Tu horario de clase de un vistazo: vista diaria en el popup, horario semanal completo, aviso de la tarea de IPE y tareas del Aula Virtual.",
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "Clase — horario",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  }
}
